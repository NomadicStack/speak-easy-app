# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Xcode 8 and later
##
## Settings the user can specify to override project settings.
## It is common to ignore this to avoid noise in the repo.
*.xcworkspace/xcshareddata/xcschemes/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcshareddata/xcschemes/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcshareddata/SwiftPM/Package.resolved

## Build artifacts
build/
DerivedData/

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.moved-aside
*.xcscheme
*.plist

## Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# .build/
# Packages/
# Package.pins
# Package.resolved
# .swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
# .swiftpm/xcode/xcuserdata

# macOS
#
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Models and Large Assets
DysarthriaApp/Models/
Models/
model/
venv312/
model_backups/
*.zip

# Others
*.swp
*.lock
.env

# Node.js and Firebase
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.eslintcache
.firebase/
**/*-debug.log
**/functions/.runtimeconfig.json
**/functions/*.local
**/functions/*secret.local
